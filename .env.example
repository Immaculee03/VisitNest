# ─────────────────────────────────────────────────────────────
# VisitNest – Environment Variables
# IMPORTANT: Never upload this file to GitHub.
#            It is listed in .gitignore for security.
# Copy this file, rename it to .env, and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=visit_nest_db
DB_USER=visitnest_user
DB_PASSWORD=visitnest_pass123
DB_ROOT_PASSWORD=root_secret_123

# ── Backend API ───────────────────────────────
PORT=5000
NODE_ENV=development

# ── Authentication ────────────────────────────
JWT_SECRET=visitnest_jwt_super_secret_key_2026
JWT_EXPIRES_IN=8h

# ── Frontend ──────────────────────────────────
REACT_APP_API_URL=http://localhost:5000
